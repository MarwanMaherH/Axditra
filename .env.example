# Copy this file to .env and fill in your keys.

# Required for AI explanations + fixes. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your-key-here

# Optional — only needed if you want confirmation emails on waitlist signup.
# Get a free key at https://resend.com (100 emails/day on the free tier).
# Without this, signups still get saved to data/waitlist.json — you just
# won't send a confirmation email.
RESEND_API_KEY=
WAITLIST_FROM_EMAIL=AccessPilot <onboarding@resend.dev>

PORT=3000
