# Copy this file to .env and fill in your keys.
# Get an Anthropic API key at https://console.anthropic.com

# Required for AI explanations + fixes.
ANTHROPIC_API_KEY=

# Server
PORT=3000
ADMIN_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Optional — only needed if you want confirmation emails on waitlist signup.
# Get a free key at https://resend.com
RESEND_API_KEY=
WAITLIST_FROM_EMAIL=AccessPilot <onboarding@resend.dev>